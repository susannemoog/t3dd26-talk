[0.020, "o", "\r\n  herdr — Demo 1: Worktrees pro Agent\r\n"]
[0.000, "o", "  ─────────────────────────────────────\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  $ herdr worktree list --cwd /Volumes/cs/projects/dxp/demos/talk\r\n"]
[0.022, "o", "    main  /Volumes/cs/projects/dxp/demos/talk\r\n"]
[0.002, "o", "\r\n"]
[0.000, "o", "  $ herdr worktree create --branch wt-talk-a11y --label a11y\r\n"]
[0.231, "o", "    ✓ wt-talk-a11y  · /Volumes/cs/worktrees/talk/wt-talk-a11y\r\n"]
[6.022, "o", "\r\n  $ herdr worktree create --branch wt-talk-script --label script\r\n"]
[0.198, "o", "    ✓ wt-talk-script  · /Volumes/cs/worktrees/talk/wt-talk-script\r\n"]
[6.015, "o", "\r\n  $ herdr agent start a11y --kind pi --pane w1X:p1\r\n"]
[3.053, "o", "    ✓ a11y  idle\r\n"]
[0.003, "o", "\r\n  $ herdr agent start scripter --kind pi --pane w1Y:p1\r\n"]
[3.049, "o", "    ✓ scripter  idle\r\n"]
[0.002, "o", "\r\n"]
